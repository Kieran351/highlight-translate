{
  "manifest_version": 3,
  "name": "Highlight Translate",
  "version": "0.1.0",
  "description": "在网页内把选中的外语文本翻译为简体中文。",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 Highlight Translate 设置",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://chromewebstore.google.com/*", "https://chrome.google.com/webstore/*"],
      "js": ["content/content-script.js"],
      "all_frames": false,
      "match_about_blank": false,
      "run_at": "document_idle"
    }
  ]
}
